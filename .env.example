# ── Copy to .env and fill in values ──────────────────────────────────────────

# Fraud scoring threshold (0.0–1.0)
FRAUD_THRESHOLD=0.5

# Redis connection
REDIS_URL=redis://redis:6379/0

# Model artifact directory (inside container)
MODEL_PATH=/app/models

# Logging level: debug | info | warning | error
LOG_LEVEL=info

# API rate limit (requests per minute per IP)
RATE_LIMIT_PER_MIN=120

# Dataset path (for trainer service)
DATA_PATH=/app/data/creditcard.csv

# Kaggle credentials (needed to download dataset)
KAGGLE_USERNAME=your_username_here
KAGGLE_KEY=your_api_key_here
