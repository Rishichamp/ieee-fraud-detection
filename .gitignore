# =============================================================================
# .gitignore — IEEE-CIS Financial Fraud Detection System
# =============================================================================

# ── Dataset files (too large for GitHub, download via Kaggle) ────────────────
data/ieee_cis/*.csv
data/ieee_cis/*.zip
data/creditcard/*.csv
data/creditcard/*.zip

# ── Processed numpy arrays (regenerated by preprocessing script) ─────────────
data/ieee_cis/processed/*.npy
data/ieee_cis/processed/scaler.pkl
data/ieee_cis/processed/label_encoders.pkl

# ── Trained model binaries (tracked via Git LFS or registry) ─────────────────
# Comment these out if you want to commit small models (<100MB)
# models/ieee/*.pkl
# models/ieee/*.h5
# models/ieee/*.keras
# models/*.pkl

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
*.env
.env.local
.env.production

# ── Kaggle credentials ────────────────────────────────────────────────────────
kaggle.json
*.kaggle

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Docker ────────────────────────────────────────────────────────────────────
nginx/ssl/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
*.pid

# ── SHAP plots ────────────────────────────────────────────────────────────────
shap_summary.png
shap_waterfall.png

# ── Misc ──────────────────────────────────────────────────────────────────────
*.zip
*.tar.gz
*.docx
